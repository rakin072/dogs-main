# Admin Panel Environment Configuration

# API Configuration
API_BASE_URL=http://localhost:5000
BACKEND_URL=http://localhost:5000

# Production URLs (update for production)
PRODUCTION_API_URL=https://api.yourdomain.com
PRODUCTION_BACKEND_URL=https://api.yourdomain.com

# Admin Panel Configuration
ADMIN_TITLE=TWS Vision Admin Panel
ADMIN_VERSION=1.0.0
ADMIN_DESCRIPTION=Administrative interface for TWS Vision platform

# Security
ADMIN_SECRET_KEY=your_admin_secret_key_here
SESSION_TIMEOUT=3600

# Features
ENABLE_USER_MANAGEMENT=true
ENABLE_TASK_MANAGEMENT=true
ENABLE_WITHDRAWAL_MANAGEMENT=true
ENABLE_CONFIGURATION_MANAGEMENT=true

# UI Configuration
THEME_COLOR=#667eea
ACCENT_COLOR=#764ba2
SUCCESS_COLOR=#4facfe
DANGER_COLOR=#f5576c

# Development Settings
DEBUG_MODE=true
VERBOSE_LOGGING=true

# Production Settings (uncomment for production)
# API_BASE_URL=https://api.yourdomain.com
# BACKEND_URL=https://api.yourdomain.com
# ADMIN_SECRET_KEY=your_production_admin_secret_key_here
# DEBUG_MODE=false
# VERBOSE_LOGGING=false
